# Copie para .env e troque os valores. Nunca suba o .env para o repositório.
POSTGRES_USER=filazero
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=filazero
DATABASE_URL=postgresql://filazero:troque-esta-senha@db:5432/filazero

# JWT: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"  (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRA_MIN=60

# Sal do hash que identifica o cidadão no lake (nenhum dado pessoal sai do banco)
PSEUDONIMO_SAL=

# Senha dos dois usuários de demonstração (cidadao@filazero.dev e gestora@filazero.dev).
# Deixe vazio para não criar esses usuários.
SEED_SENHA=

# Origens que podem chamar a API, separadas por vírgula
CORS_ORIGENS=http://localhost:5173

# Agente de triagem com LLM (opcional). Vazio = só regras. Preenchido, o relato do cidadão é enviado à API da Anthropic.
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPICO=filazero/ubs/+/sala

# Front. Deixe vazio para o front procurar a API no mesmo endereço que o abriu (porta 8000);
# é o que faz funcionar no celular pela rede Wi-Fi. Preencha só se a API estiver em outro host.
VITE_API_URL=
